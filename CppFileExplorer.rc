#include <windows.h>
#include "Resource.h"

// Main Application Menu
IDR_MAINMENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New Folder\tCtrl+N",       IDM_FILE_NEWFOLDER
        MENUITEM "&Rename\tF2",                IDM_FILE_RENAME
        MENUITEM "&Delete\tDel",               IDM_FILE_DELETE
        MENUITEM SEPARATOR
        MENUITEM "&Properties\tAlt+Enter",     IDM_FILE_PROPERTIES
        MENUITEM SEPARATOR
        MENUITEM "E&xit\tAlt+F4",              IDM_FILE_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "Cu&t\tCtrl+X",               IDM_EDIT_CUT
        MENUITEM "&Copy\tCtrl+C",              IDM_EDIT_COPY
        MENUITEM "&Paste\tCtrl+V",             IDM_EDIT_PASTE
        MENUITEM SEPARATOR
        MENUITEM "Select &All\tCtrl+A",        IDM_EDIT_SELECTALL
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Refresh\tF5",               IDM_VIEW_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "&Details View",              IDM_VIEW_DETAILS
        MENUITEM "&Large Icons View",          IDM_VIEW_LARGEICONS
        MENUITEM "&List View",                 IDM_VIEW_LIST
        MENUITEM SEPARATOR
        MENUITEM "Toggle &Details Panel",      IDM_VIEW_TOGGLE_DETAILS
        MENUITEM "Toggle &Dark/Light Theme",   IDM_VIEW_TOGGLE_THEME
    END
    POPUP "&Tools"
    BEGIN
        MENUITEM "&Folder Statistics (DFS/BFS Tree Traversal)...", IDM_TOOLS_FOLDER_STATS
        MENUITEM "&Open Command Prompt Here",   IDM_TOOLS_OPEN_CMD
        MENUITEM SEPARATOR
        MENUITEM "&Refresh View\tF5",          IDM_VIEW_REFRESH
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Keyboard Shortcuts && Guide\tF1", IDM_HELP_SHORTCUTS
        MENUITEM SEPARATOR
        MENUITEM "&About C++ Based File Explorer...", IDM_HELP_ABOUT
    END
END

// Keyboard Accelerators
IDA_ACCELERATORS ACCELERATORS
BEGIN
    "L",          IDC_ADDRESS_BAR,        VIRTKEY, CONTROL
    "F",          IDC_SEARCH_BOX,         VIRTKEY, CONTROL
    "N",          IDM_FILE_NEWFOLDER,     VIRTKEY, CONTROL
    "C",          IDM_EDIT_COPY,          VIRTKEY, CONTROL
    "X",          IDM_EDIT_CUT,           VIRTKEY, CONTROL
    "V",          IDM_EDIT_PASTE,         VIRTKEY, CONTROL
    "A",          IDM_EDIT_SELECTALL,     VIRTKEY, CONTROL
    VK_F1,        IDM_HELP_SHORTCUTS,     VIRTKEY
    VK_F5,        IDM_VIEW_REFRESH,       VIRTKEY
    VK_F2,        IDM_FILE_RENAME,        VIRTKEY
    VK_DELETE,    IDM_FILE_DELETE,        VIRTKEY
    VK_LEFT,      IDC_NAV_BACK,           VIRTKEY, ALT
    VK_RIGHT,     IDC_NAV_FORWARD,        VIRTKEY, ALT
    VK_BACK,      IDC_NAV_UP,             VIRTKEY
    VK_RETURN,    IDM_FILE_PROPERTIES,    VIRTKEY, ALT
END
